#!/bin/zsh
# Self-contained launcher: builds and runs the game with zero PATH assumptions.
# This is the M0 ancestor of the one-command host script from the plan.
set -e

DOTNET="$HOME/.dotnet/dotnet"
GODOT="$HOME/Applications/Godot_mono.app/Contents/MacOS/Godot"
HERE="$(cd "$(dirname "$0")" && pwd)"

[ -x "$DOTNET" ] || { echo "missing .NET SDK at $DOTNET — see docs/INSTALL.md"; exit 1; }
[ -x "$GODOT" ]  || { echo "missing Godot at $GODOT — see docs/INSTALL.md"; exit 1; }

# Godot's mono module locates hostfxr by running `dotnet` and reading
# DOTNET_ROOT — both must point at the user-local install or the engine
# boots without C# ("Failed to load hostfxr").
export DOTNET_ROOT="$HOME/.dotnet"
export PATH="$HOME/.dotnet:$PATH"

"$DOTNET" build "$HERE/game/DeepField.Game.csproj" -v quiet
exec "$GODOT" --path "$HERE/game" "$@"
