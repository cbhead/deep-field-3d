#!/bin/zsh
# Self-contained launcher: builds and runs the game with zero PATH assumptions.
# This is the M0 ancestor of the one-command host script from the plan.
set -e

DOTNET="$HOME/.dotnet/dotnet"
GODOT="$HOME/Applications/Godot_mono.app/Contents/MacOS/Godot"
HERE="$(cd "$(dirname "$0")" && pwd)"

[ -x "$DOTNET" ] || { echo "missing .NET SDK at $DOTNET — see docs/INSTALL.md"; exit 1; }
[ -x "$GODOT" ]  || { echo "missing Godot at $GODOT — see docs/INSTALL.md"; exit 1; }

# Godot's mono module locates hostfxr by running `dotnet` and reading
# DOTNET_ROOT — both must point at the user-local install or the engine
# boots without C# ("Failed to load hostfxr").
export DOTNET_ROOT="$HOME/.dotnet"
export PATH="$HOME/.dotnet:$PATH"

# Engine flags after `--` are silently ignored: Godot hands everything past the
# separator to the game as user args. Getting --quit-after on the wrong side of
# it means a headless run never exits, and because it still prints its normal
# output nothing looks wrong — three of these once sat spinning for twenty
# hours before anyone noticed. Refuse rather than hang.
seen_sep=0
for arg in "$@"; do
  if [ "$arg" = "--" ]; then seen_sep=1; continue; fi
  if [ $seen_sep -eq 1 ]; then
    case "$arg" in
      --quit-after|--quit-after=*|--quit|--headless|--path|--import|--build-solutions)
        echo "error: '$arg' is an engine flag but sits after '--', where Godot" >&2
        echo "       ignores it. A headless run would never exit. Move it before" >&2
        echo "       the separator:  ./play --headless $arg -- --solo <map>" >&2
        exit 2 ;;
    esac
  fi
done

"$DOTNET" build "$HERE/game/DeepField.Game.csproj" -v quiet
exec "$GODOT" --path "$HERE/game" "$@"
