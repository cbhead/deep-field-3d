{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepfield.dev/content/statuses.schema.json",
  "title": "statuses",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "table",
    "generated",
    "rows"
  ],
  "properties": {
    "$schema": {
      "const": "deepfield-content/1"
    },
    "table": {
      "type": "string"
    },
    "generated": {
      "type": "string"
    },
    "sourceSha": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
