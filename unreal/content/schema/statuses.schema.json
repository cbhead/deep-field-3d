              "Thermal",
              "Toxin",
              "Defense",
              "Vulnerability",
              "Control",
              "Tether",
              "Detection"
            ]
          },
          "speedFactor": {
            "type": "number"
          },
          "damagePerSecond": {
            "type": "number"
          },
          "damageTakenFactor": {
            "type": "number"
          },
          "armorDelta": {
            "type": "number"
          },
          "hardControl": {
            "type": "boolean"
          },
          "maxDurationSeconds": {
            "type": "number"
          },
          "ignoresArmor": {
            "type": "boolean"
          },
          "ignoresShield": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
